# ==============================================================================
# Django Core Settings
# ==============================================================================
# Cryptographic signing key. Replace with a strong random value in production.
DJANGO_SECRET_KEY=

# Enable/disable Django debug mode (True for local development, False in production).
DJANGO_DEBUG=True

# Comma-separated list of host/domain names this Django site can serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================
# Used by both Docker Compose (db service) and Django (backend/config/settings.py).
POSTGRES_DB=saas_website_builder
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-db-password

# Use "db" when running Django inside Docker Compose, or "localhost" for local host execution.
DB_HOST=db
DB_PORT=5432

# ==============================================================================
# Application URLs
# ==============================================================================
# Base URL of the frontend application (used for password reset links).
FRONTEND_URL=http://localhost:3000
